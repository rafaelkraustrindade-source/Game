class Enemy : Body
{
    enum State { Move, Windup, Recover }

    readonly float speed = 130f;
    readonly float detectRange = 450f;
    readonly float attackRange = 60f;
    readonly float patrolRange = 150f;
    readonly float damage;
    readonly float windupTime = 0.6f;   // tempo que ele "telegrafa" o golpe (amarelo)
    readonly float recoverTime = 0.9f;
    public int SoulsReward = 50;
    public float DeadTimer;

    readonly Game game;
    readonly float originX;
    State state = State.Move;
    float timer;

    public Enemy(Game game, float x, float y, bool boss = false)
    {
        this.game = game;
        X = x; Y = y;
        originX = x;
        if (boss)
        {
            W = 46; H = 80; MaxHP = HP = 200; damage = 35; SoulsReward = 300;
            BaseColor = new Color(140, 40, 160, 255);
        }
        else
        {
            W = 32; H = 56; MaxHP = HP = 60; damage = 20;
            BaseColor = new Color(204, 76, 76, 255);
        }
    }

    public void Update(Game g, float dt)
    {
        float now = g.Now;
        var p = g.Player;

        if (Dead)
        {
            DeadTimer += dt;
            Vel.X *= 0.9f;
            Vel.Y += Gravity * dt;
            MoveAndCollide(dt, g.Solids);
            return;
        }

        bool stunned = now < StunUntil;
        if (stunned && state != State.Move) state = State.Move; // stagger cancela o ataque

        if (stunned)
        {
            Vel.X -= Vel.X * 8f * dt;
        }
        else
        {
            switch (state)
            {
                case State.Move:
                    float dx = p.Center.X - Center.X;
                    float dy = MathF.Abs(p.Center.Y - Center.Y);
                    bool sees = MathF.Abs(dx) < detectRange && dy < 130 && !p.Dead;

                    if (sees)
                    {
                        Facing = dx >= 0 ? 1 : -1;
                        if (MathF.Abs(dx) > attackRange)
                            Vel.X = Facing * speed * 1.3f;
                        else
                        {
                            Vel.X = 0;
                            state = State.Windup;
                            timer = windupTime;
                        }
                    }
                    else
                    {
                        if (MathF.Abs(Center.X - originX) > patrolRange)
                            Facing = originX >= Center.X ? 1 : -1;
                        Vel.X = Facing * speed * 0.5f;
                    }
                    break;

                case State.Windup:
                    Vel.X = 0;
                    timer -= dt;
                    if (timer <= 0)
                    {
                        Strike(g);
                        state = State.Recover;
                        timer = recoverTime;
                    }
                    break;

                case State.Recover:
                    Vel.X = 0;
                    timer -= dt;
                    if (timer <= 0) state = State.Move;
                    break;
            }
        }

        Vel.Y += Gravity * dt;
        MoveAndCollide(dt, g.Solids);
    }

    void Strike(Game g)
    {
        var hit = new Rectangle(
            Facing > 0 ? X + W : X - attackRange,
            Y - 4, attackRange, H + 8);
        g.AddEffect(hit, new Color(255, 80, 30, 150), 0.12f);

        if (Raylib.CheckCollisionRecs(hit, g.Player.Rect))
            g.Player.TakeDamage(damage, Center.X, g.Now, 0.3f);
    }

    public void Draw(float now)
    {
        // amarelo = vai atacar! hora de rolar
        DrawBody(now, state == State.Windup ? Color.Yellow : BaseColor);
    }
}