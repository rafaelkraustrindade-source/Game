using System.Numerics;
using Raylib_cs;

/// Base de qualquer coisa que tem corpo, vida e física.
abstract class Body
{
    public const float Gravity = 1800f;

    public float X, Y, W, H;
    public Vector2 Vel;
    public bool OnGround;
    public float HP, MaxHP;
    public bool Invincible, Dead;
    public float StunUntil, FlashUntil;
    public int Facing = 1;
    public Color BaseColor = Color.White;

    public Rectangle Rect => new Rectangle(X, Y, W, H);
    public Vector2 Center => new Vector2(X + W / 2f, Y + H / 2f);

    public void MoveAndCollide(float dt, List<Rectangle> solids)
    {
        // eixo X
        X += Vel.X * dt;
        var rx = new Rectangle(X, Y + 0.5f, W, H - 1f);
        foreach (var s in solids)
        {
            if (!Raylib.CheckCollisionRecs(rx, s)) continue;
            if (Vel.X > 0) X = s.X - W;
            else if (Vel.X < 0) X = s.X + s.Width;
            rx = new Rectangle(X, Y + 0.5f, W, H - 1f);
        }

        // eixo Y
        Y += Vel.Y * dt;
        OnGround = false;
        foreach (var s in solids)
        {
            if (!Raylib.CheckCollisionRecs(Rect, s)) continue;
            if (Vel.Y > 0) { Y = s.Y - H; OnGround = true; Vel.Y = 0; }
            else if (Vel.Y < 0) { Y = s.Y + s.Height; Vel.Y = 0; }
        }
    }

    public bool TakeDamage(float dmg, float fromX, float now, float stun = 0.25f)
    {
        if (Dead || Invincible) return false;

        HP -= dmg;
        StunUntil = now + stun;
        FlashUntil = now + 0.1f;

        float dir = Center.X >= fromX ? 1f : -1f;
        Vel = new Vector2(dir * 260f, -220f);   // knockback
        OnGround = false;

        if (HP <= 0) { HP = 0; Dead = true; }
        return true;
    }

    protected void DrawBody(float now, Color color)
    {
        Color c = Dead ? Color.Gray : (now < FlashUntil ? Color.Red : color);
        Raylib.DrawRectangleRec(Rect, c);
        // "olho" pra mostrar pra onde está virado
        int ex = Facing > 0 ? (int)(X + W - 12) : (int)(X + 2);
        Raylib.DrawRectangle(ex, (int)Y + 10, 10, 6, Color.White);
    }
}

