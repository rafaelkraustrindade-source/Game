class Player : Body
{
    // Ajuste à vontade
    const float MoveSpeed = 260f;
    const float JumpVel = 720f;
    const float RollSpeed = 480f;
    const float RollTime = 0.35f;
    public const float MaxStamina = 100f;
    const float StaminaRegen = 35f;
    const float RollCost = 25f;
    const float AttackCost = 20f;
    const float AttackDamage = 25f;
    const float AttackRange = 70f;
    const float FlaskHeal = 40f;

    enum State { Free, Roll, Attack, Heal }

    public float Stamina = MaxStamina;
    public int Flasks = 3;
    public int Souls;

    State state = State.Free;
    float timer;
    int attackPhase;
    float lastStaminaUse;

    public Player(float x, float y)
    {
        X = x; Y = y; W = 28; H = 56;
        MaxHP = HP = 100;
        BaseColor = new Color(76, 178, 255, 255);
    }

    void UseStamina(float amount, float now)
    {
        Stamina = MathF.Max(0, Stamina - amount);
        lastStaminaUse = now;
    }

    public void Update(Game g, float dt)
    {
        float now = g.Now;

        if (Dead)
        {
            Vel.X *= 0.9f;
            Vel.Y += Gravity * dt;
            MoveAndCollide(dt, g.Solids);
            return;
        }

        bool stunned = now < StunUntil;
        if (stunned && (state == State.Attack || state == State.Heal))
            state = State.Free; // tomou dano: cancela a ação

        float axis = 0;
        if (Raylib.IsKeyDown(KeyboardKey.D) || Raylib.IsKeyDown(KeyboardKey.Right)) axis += 1;
        if (Raylib.IsKeyDown(KeyboardKey.A) || Raylib.IsKeyDown(KeyboardKey.Left)) axis -= 1;

        switch (state)
        {
            case State.Free:
                if (stunned)
                {
                    Vel.X -= Vel.X * 8f * dt;
                    break;
                }

                Vel.X = axis * MoveSpeed;
                if (axis != 0) Facing = (int)axis;

                if (Raylib.IsKeyPressed(KeyboardKey.Space) && OnGround)
                    Vel.Y = -JumpVel;

                if ((Raylib.IsKeyPressed(KeyboardKey.LeftShift) || Raylib.IsKeyPressed(KeyboardKey.K)) && Stamina > 0)
                {
                    state = State.Roll;
                    timer = RollTime;
                    Invincible = true;
                    UseStamina(RollCost, now);
                }
                else if ((Raylib.IsKeyPressed(KeyboardKey.J) || Raylib.IsMouseButtonPressed(MouseButton.Left)) && Stamina > 0)
                {
                    state = State.Attack;
                    attackPhase = 0;
                    timer = 0.12f; // windup
                    UseStamina(AttackCost, now);
                }
                else if (Raylib.IsKeyPressed(KeyboardKey.Q) && Flasks > 0 && HP < MaxHP)
                {
                    state = State.Heal;
                    timer = 0.6f;
                }
                break;

            case State.Roll:
                Vel.X = Facing * RollSpeed;
                timer -= dt;
                if (timer <= 0) { Invincible = false; state = State.Free; }
                break;

            case State.Attack:
                Vel.X = 0;
                timer -= dt;
                if (attackPhase == 0 && timer <= 0)
                {
                    DoHit(g);
                    attackPhase = 1;
                    timer = 0.25f; // recovery
                }
                else if (attackPhase == 1 && timer <= 0) state = State.Free;
                break;

            case State.Heal:
                Vel.X = 0;
                timer -= dt;
                if (timer <= 0)
                {
                    Flasks--;
                    HP = MathF.Min(MaxHP, HP + FlaskHeal);
                    state = State.Free;
                }
                break;
        }

        // regen de stamina
        if (state == State.Free && now > lastStaminaUse + 0.8f)
            Stamina = MathF.Min(MaxStamina, Stamina + StaminaRegen * dt);

        Vel.Y += Gravity * dt;
        MoveAndCollide(dt, g.Solids);
    }

    void DoHit(Game g)
    {
        var hit = new Rectangle(
            Facing > 0 ? X + W : X - AttackRange,
            Y - 4, AttackRange, H + 8);
        g.AddEffect(hit, new Color(255, 255, 255, 110), 0.1f);

        foreach (var e in g.Enemies)
        {
            if (e.Dead || !Raylib.CheckCollisionRecs(hit, e.Rect)) continue;
            e.TakeDamage(AttackDamage, Center.X, g.Now);
            if (e.Dead) Souls += e.SoulsReward;
        }
    }

    public void Draw(float now)
    {
        Color c = state == State.Roll ? new Color(76, 178, 255, 100)
                : state == State.Heal ? Color.Green
                : BaseColor;
        DrawBody(now, c);
    }
}

